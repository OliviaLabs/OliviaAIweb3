{
  "name": "-beta-wallet-v2",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "dev:frontend-only": "vite --port 3001",
    "prebuild": "node optimize-assets.js",
    "postbuild": "node restore-assets.js",
    "build": "cd frontend && NODE_OPTIONS=\"--max-old-space-size=2048\" vite build",
    "build:production": "npm run prebuild && npm run build && npm run postbuild",
    "start": "cd microservice && npm install && npm start",
    "start:microservice": "cd microservice && npm install && npm start",
    "start:frontend": "cd frontend && vite preview --port 3000",
    "lint": "eslint .",
    "preview": "cd frontend && vite preview",
    "test:integration": "node test-frontend-integration.js",
    "icp:start": "cd microservice/src/plugins/icp/canister && dfx start --background",
    "icp:stop": "cd microservice/src/plugins/icp/canister && dfx stop",
    "icp:deploy": "cd microservice/src/plugins/icp/canister && dfx deploy",
    "icp:status": "cd microservice/src/plugins/icp/canister && dfx canister status --all",
    "icp:clean": "cd microservice/src/plugins/icp/canister && dfx stop && rm -rf .dfx && dfx start --clean --background",
    "setup": "./dev-setup.sh"
  },
  "dependencies": {
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
    "@dfinity/identity": "^2.4.1",
    "@dfinity/principal": "^2.4.1",
    "@heroui/react": "^2.8.4",
    "@heroui/theme": "2.4.22",
    "@internationalized/date": "^3.10.0",
    "@react-aria/i18n": "^3.12.13",
    "@reown/appkit": "^1.7.20",
    "@reown/appkit-adapter-wagmi": "^1.7.20",
    "@reown/appkit-siwe": "^1.7.20",
    "@supabase/supabase-js": "^2.39.3",
    "@tanstack/react-query": "^5.85.5",
    "@telegram-apps/analytics": "^1.3.13",
    "axios": "^1.11.0",
    "chart.js": "^4.4.8",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.18",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "formik": "^2.4.6",
    "framer-motion": "^12.4.3",
    "lucide-react": "^0.475.0",
    "noisejs": "2.1.0",
    "prop-types": "^15.8.1",
    "qs": "^6.14.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^9.0.3",
    "react-phone-number-input": "^3.4.12",
    "react-router-dom": "^6.29.0",
    "react-select": "^5.10.2",
    "recharts": "^3.2.1",
    "sonner": "^1.7.4",
    "uuid": "^11.0.5",
    "validator": "^13.15.15",
    "viem": "^2.34.0",
    "wagmi": "^2.16.4",
    "wavesurfer.js": "^7.9.0"
  },
  "devDependencies": {
    "@babel/code-frame": "^7.27.1",
    "@eslint/js": "^9.19.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.36.0",
    "vite": "^6.1.0"
  }
}
